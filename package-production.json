{
  "name": "nmea-2000-simulator",
  "version": "1.0.0",
  "description": "NMEA 2000 Marine Data Simulator with Signal K support",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --target=node20 --outfile=dist/index.js --external:pg-native",
    "postbuild": "cp -r client/dist/* dist/public/ 2>/dev/null || true"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.9.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "connect-pg-simple": "^9.0.1",
    "csv-writer": "^1.6.0",
    "drizzle-orm": "^0.29.0",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "nanoid": "^5.0.4",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^2.2.0",
    "ws": "^8.16.0",
    "zod": "^3.22.4",
    "zod-validation-error": "^2.1.0"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.17.10",
    "@types/node": "^20.11.5",
    "@types/passport": "^1.0.16",
    "@types/passport-local": "^1.0.38",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "drizzle-kit": "^0.20.9",
    "esbuild": "^0.19.12",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.12"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "nmea",
    "marine",
    "navigation",
    "simulator",
    "signalk",
    "opencpn"
  ],
  "author": "NMEA Simulator",
  "license": "MIT"
}